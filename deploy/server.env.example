# Point both names at the server's IP address first (DNS A records).
RELAY_DOMAIN=relay.example.com
NTFY_DOMAIN=ntfy.example.com

# A long random secret: `openssl rand -base64 32`. Store the same value on the
# desktop with `malves secret set RELAY_TOKEN`.
RELAY_TOKEN=

# Optional lead engine (`--profile leads`). LEADS_KEY is signalstack's UI_KEY;
# store the same value on the desktop with `malves secret set LEADS_KEY`.
# Copy signalstack's config.example.yaml to deploy/signalstack.yaml and edit it.
#LEADS_UPSTREAM=http://signalstack:8000
#LEADS_KEY=
# An ntfy topic for the weekly digest (counts only), e.g. on your own ntfy:
#DIGEST_URL=https://ntfy.example.com/leads-<random>
