{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@malves/protocol": ["./packages/protocol/src/index.ts"],
      "@malves/core": ["./packages/core/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/protocol/src",
    "packages/protocol/test",
    "packages/core/src",
    "packages/core/test",
    "packages/runner/src",
    "packages/runner/test",
    "vitest.config.ts"
  ]
}
