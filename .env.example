# Copy to .env and fill in what you use. .env is never committed.
# Everything here is optional: with none of it, Claude Code and Codex run on
# your own subscriptions and the phone connects over Tailscale or Wi-Fi.

# Antigravity (Google's agent): a Gemini API key. Never a personal Google login.
GEMINI_API_KEY=

# Free models through freellmapi (adds "Claude (free models)" and "Codex (free models)").
# e.g. http://127.0.0.1:3001
MALVES_MODELS_URL=
MALVES_MODELS_KEY=
# Quality floor: models allowed without asking, e.g. gemini-2.5-pro,deepseek
MALVES_MODELS_ALLOW=

# Malves, the assistant: its brain is the freellmapi above; its memory lives in
# this folder (open it in Obsidian as a vault to read or edit what it remembers).
MALVES_VAULT=
# Optional: a specific fast model, e.g. a Groq one, instead of freellmapi's auto:fast
MALVES_ASSISTANT_MODEL=

# Leads from signalstack (or pass --leads).
# e.g. http://127.0.0.1:8000
MALVES_LEADS_URL=
MALVES_LEADS_KEY=

# Relay on your own server, for use without Tailscale (see packages/relay).
# e.g. wss://relay.example.com
MALVES_RELAY_URL=
MALVES_RELAY_TOKEN=

# Quiet hours for "task finished" notifications, computer time, e.g. 22-7. Questions always notify.
MALVES_QUIET_HOURS=
