# Copy to .env and fill in what you use. .env is never committed.
# Everything here is optional: with none of it, Claude Code and Codex run on
# your own subscriptions and the phone connects over Tailscale or Wi-Fi.

# Antigravity (Google's agent): a Gemini API key. Never a personal Google login.
GEMINI_API_KEY=

# Existing Codex desktop conversations: absolute path to an installed Codex executable
# whose `queue --help` supports --thread and --message. No shell shim or new agent.
# Keep the target chat open in Codex desktop. Native approval handling is not connected.
MALVES_CODEX_DESKTOP_BIN=

# Free models through freellmapi (adds "Claude (free models)" and "Codex (free models)").
# e.g. http://127.0.0.1:3001
MALVES_MODELS_URL=
MALVES_MODELS_KEY=
# Quality floor: models allowed without asking, e.g. gemini-2.5-pro,deepseek
MALVES_MODELS_ALLOW=

# Malves, the assistant: its brain is the freellmapi above; its memory lives in
# this folder (open it in Obsidian as a vault to read or edit what it remembers).
MALVES_VAULT=
# Optional: a specific fast model, e.g. a Groq one, instead of freellmapi's auto:fast
MALVES_ASSISTANT_MODEL=
# Your books and notes (PDFs, Markdown), searched with page citations. Folders separated
# like PATH (";" on Windows). Needs poppler's pdftotext on PATH (or MALVES_PDFTOTEXT).
# Embedding sends the text to the embedding model (bge-m3 through freellmapi); set
# MALVES_BOOKS_EMBED=0 to keep it all on this computer (word search only).
MALVES_BOOKS=
MALVES_BOOKS_EMBED=
# How notifications reach the phone: ntfy (default), both, or fcm (malves' own, through Firebase;
# needs MALVES_FCM_KEY below and a phone build made with google-services.json). With fcm, Google sees
# only the kind of thing that happened; set MALVES_PUSH_TEXT=1 to send a short text too.
MALVES_PUSH=
MALVES_PUSH_TEXT=
# Gmail (read and drafts only, never send): your own Google Cloud OAuth client of type
# "Desktop app" with the Gmail API on, then `malves gmail add` once per account.
MALVES_GOOGLE_CLIENT_ID=
MALVES_GOOGLE_CLIENT_SECRET=
# Set to 1 only on the always-on server copy (docs/standby.md): talk, memory, books, skills; no tasks.
MALVES_STANDBY=
# Skill folders besides ~/.claude/skills, ~/.codex/skills and ~/.agents/skills (default: those three).
MALVES_SKILLS=

# Leads from signalstack (or pass --leads).
# e.g. http://127.0.0.1:8000
MALVES_LEADS_URL=
MALVES_LEADS_KEY=

# Relay on your own server, for use without Tailscale (see packages/relay).
# e.g. wss://relay.example.com
MALVES_RELAY_URL=
MALVES_RELAY_TOKEN=

# Quiet hours for "task finished" notifications, computer time, e.g. 22-7. Questions always notify.
MALVES_QUIET_HOURS=

# Vision models for "look at this", comma-separated, tried in order (default: Llama 4 Scout, Qwen3-VL, Llama 3.2 Vision, Gemini 2.5 Flash).
MALVES_VISION_MODEL=

# Nightly encrypted backup of Malves' memory (the vault) to your server over SSH.
# Needs key-based SSH login; the backup key stays in ~/.malves/backup.key (keep a copy).
MALVES_BACKUP_SSH=
MALVES_BACKUP_SSH_KEY=

# Malves' natural voice, tried in this order per sentence (any may be left empty;
# the phone's own voice is the last resort). Free tiers: Cartesia 20k characters a
# month, ElevenLabs 10k credits. Piper runs on your own server (tailnet only).
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
MALVES_PIPER_URL=

# Malves calling your phone: the path to your Firebase project's service-account key
# (JSON, kept outside the repo). The phone build needs google-services.json too.
MALVES_FCM_KEY=

# Your name, as Malves says it (unset: "the owner").
MALVES_USER_NAME=

# Optional native Agent Desktop executable (protocol 2.6), used only during explicit handover.
# Install separately; no shell shim, no automatic download, no antivirus exclusions.
MALVES_AGENT_DESKTOP_BIN=
