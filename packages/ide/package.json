{
  "name": "malves-ide",
  "displayName": "malves",
  "description": "Connects this IDE to malves: start its agent, open changes and reopen conversations from your phone, and answer agent questions at your desk.",
  "version": "0.1.0",
  "publisher": "ladsondavid",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/LadsonDavid/Malves"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "malves.reconnect",
        "title": "malves: Reconnect to the computer's malves"
      }
    ],
    "configuration": {
      "title": "malves",
      "properties": {
        "malves.home": {
          "type": "string",
          "default": "",
          "description": "malves' data folder, if it isn't the default (~/.malves or MALVES_HOME)."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --external:bufferutil --external:utf-8-validate --outfile=dist/extension.js",
    "package": "pnpm run build && vsce package --no-dependencies --out malves.vsix"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/ws": "8.18.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
