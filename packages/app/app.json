{
  "expo": {
    "name": "malves",
    "slug": "malves",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.ladsondavid.malves"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used only to scan the pairing code shown on your computer."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "The microphone is used only while you talk to malves: to dictate tasks and answer agents.",
          "speechRecognitionPermission": "Speech recognition turns what you say into text for malves.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-notifications",
      [
        "react-native-full-screen-notification-incoming-call",
        {
          "statusBarColor": "#0B1F3A"
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "scheme": "malves"
  }
}
